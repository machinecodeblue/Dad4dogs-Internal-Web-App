# Copy to `.env` and fill in local values. `.env` is gitignored.

POSTGRES_DB=dad4dogs
POSTGRES_USER=dad4dogs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Public base URL for customer emails (booking manage links, photo feed).
# Must be a full origin with scheme — no trailing path required.
# Examples:
#   PUBLIC_SITE_URL=http://localhost:8000
#   PUBLIC_SITE_URL=https://your-subdomain.ngrok-free.app
#   PUBLIC_SITE_URL=https://app.dad4dogs.ca
PUBLIC_SITE_URL=
